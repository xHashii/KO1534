# Configuration secrets - keep templates, ignore real configs
config/*.local.ini
config/*.secret.ini
*.secret.ini
.env

# Database exports / dumps (large, never commit).
# Note: *.sql is intentionally NOT ignored — migrations/mysql/*.sql are source.
# The generated data file is ignored because it is large and reproducible.
*.sql.gz
*.bak
*.dump
*.dump.gz
mysql-data/
migrations/_import/
KO1534.sql
KO1534_utf8.sql

# Quest / script runtime caches
Quests/Cache/

# Game data binaries (keep data/ structure and .gitkeep, ignore real files).
# The user's 1534 maps/quests/AI-event files are committed intentionally.
# Prefer shipping maps/quests in a separate data distribution, not in Git.
# (Currently commented out — uncomment to exclude from Git.)
# data/map/*.smd
# data/Quests/*.lua

