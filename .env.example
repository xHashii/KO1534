# Copy to ".env" (next to docker-compose.yml) to override the defaults.
# ".env" is gitignored - never commit real credentials.
#
# The values below are the local-development defaults that docker-compose.yml
# already uses; change them if port 3306 is taken or you want another password.
# If you change MYSQL_USER / MYSQL_PASSWORD you must use the same values in
# config/GameServer.ini, config/LogInServer.ini and config/AIServer.ini.

MYSQL_ROOT_PASSWORD=ko1534root
MYSQL_DATABASE=KO1534
MYSQL_USER=ko1534
MYSQL_PASSWORD=ko1534
MYSQL_PORT=3306
